# ---------------------------------------------------------------------------
# Runtime variables — set these in Coolify's env panel as normal (NOT build)
# variables. They are read from process.env by server-only code.
# ---------------------------------------------------------------------------

# Public URL this editor is served from: scheme + host, no trailing slash and
# no path. NextAuth builds its OAuth callback from it, and behind a reverse
# proxy it cannot infer the external hostname — omit this and sign-in redirects
# to localhost. Must match the redirect URI registered in Google Cloud Console:
#   <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000

# Encrypts the session cookie and signs the JWT. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required even when TEST_MODE=true — NextAuth v4 hard-fails without it in
# production. Changing it logs every user out.
NEXTAUTH_SECRET=

# Google OAuth web client. GOOGLE_CLIENT_ID must be the same value the backend
# verifies as its audience, or every API call comes back 401.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend origin used by the /api/[...proxy] route. Bare origin — do NOT add a
# trailing /api: callers already include that prefix and the proxy forwards the
# path verbatim. In Coolify use the internal service hostname, since this call
# is container-to-container and never leaves the server.
BACK_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Build-time variable — must be ticked as a "Build Variable" in Coolify.
# ---------------------------------------------------------------------------

# Inlined into the client bundle by next.config.js, so a runtime-only value has
# no effect. true hides the sign-in UI and pairs with the backend's guest-user
# bypass; the backend must be set to the same value.
TEST_MODE=false
